@model IEnumerable<Asb404.Models.Gallary>
@using Asb404.Models
@using PagedList;
@using PagedList.Mvc;
@{
    DBContexter _db = new DBContexter();
}

<div class="portfolio-items">
    @foreach (var item in Model)
    {
        string cs = "", Website = "";
        var mm = _db.Projects.Find(item.idx);
        if (mm != null)
        {
            cs = _db.Projects.Find(item.idx).Customer;
            Website = _db.Projects.Find(item.idx).Website;
        }

        var imagePath = item.image ?? "";
        if (!string.IsNullOrWhiteSpace(imagePath) && !imagePath.StartsWith("~"))
        {
            imagePath = imagePath.StartsWith("/") ? "~" + imagePath : "~/" + imagePath;
        }

        <div class="col-sm-3 col-xs-12 portfolio-item html">
            <div class="view efffect">

                <div class="portfolio-image">
                    <img src="@Url.Content(imagePath)" alt="" style="height:200px;width:300px;">

                </div>
                <div class="mask text-center">
                    <h3>@cs</h3>
                    <h4>@item.Discription.ToString()</h4>
                    @if (item.Date != null && String.IsNullOrEmpty(item.Date) == false)
                    {
                        <h4>@item.Date.ToString()</h4>
                    }
                    <a href="@Website"><i class="fa fa-link"></i></a>
                    <a href="@Url.Content(imagePath)" data-gallery="prettyPhoto"><i class="fa fa-search-plus"></i></a>
                    @if (Request.IsAuthenticated)
                    {
                    <a href="~/Gallary/Delete/@item.id"><i class="fa fa-minus"></i></a>
                    }
                </div>
            </div>
        </div>
    }

</div>


@if (Model is IPagedList)
{
    <br />
    <div>
        @Html.PagedListPager((IPagedList)Model, page => Url.Action("_List", new
        {
           page,
           LiElementClasses = new List<string>
        { "portfolio-image", "portfolio-item" },
           DisplayLinkToFirstPage = PagedListDisplayMode.Always,
           DisplayLinkToLastPage = PagedListDisplayMode.Always,
           DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
           DisplayLinkToNextPage = PagedListDisplayMode.Always,
           MaximumPageNumbersToDisplay = 5,
           @Productid = 2,
           Text = ViewBag.text
        }), PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(new AjaxOptions() { HttpMethod = "get", UpdateTargetId = "targetpanel", InsertionMode = InsertionMode.Replace, LoadingElementId = "div_loading", OnSuccess = "reinitGallery" }))
    </div>
}
