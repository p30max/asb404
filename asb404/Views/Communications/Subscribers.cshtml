@model IEnumerable<Asb404.Models.Subscribe>
@{
    ViewBag.Title = "&#x0645;&#x0634;&#x062a;&#x0631;&#x06a9;&#x200c;&#x0647;&#x0627;&#x06cc; &#x062e;&#x0628;&#x0631;&#x0646;&#x0627;&#x0645;&#x0647;";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
<section class="container" style="margin-top:30px;direction:rtl;">
    <h3>&#x0645;&#x0634;&#x062a;&#x0631;&#x06a9;&#x200c;&#x0647;&#x0627;&#x06cc; &#x062e;&#x0628;&#x0631;&#x0646;&#x0627;&#x0645;&#x0647;</h3>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>&#x0627;&#x06cc;&#x0645;&#x06cc;&#x0644;</th>
                <th>&#x0639;&#x0645;&#x0644;&#x06cc;&#x0627;&#x062a;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.Email</td>
                    <td>
                        @using (Html.BeginForm("DeleteSubscriber", "Communications", FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to delete this subscriber?');" }))
                        {
                            @Html.Hidden("id", item.ID)
                            <button class="btn btn-sm btn-danger" type="submit">&#x062d;&#x0630;&#x0641;</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
