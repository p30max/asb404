@model IEnumerable<Asb404.Models.ContactMessage>
@{
    ViewBag.Title = "\u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u062a\u0645\u0627\u0633";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
<section class="container" style="margin-top:30px;direction:rtl;">
    <h3>&#x67e;&#x6cc;&#x0627;&#x0645;&#x200c;&#x0647;&#x0627;&#x06cc; &#x062a;&#x0645;&#x0627;&#x0633;</h3>
    <style>
        .comm-actions {
            display: flex;
            gap: 6px;
            align-items: center;
            flex-wrap: nowrap;
        }

        .comm-actions form {
            margin: 0;
        }
    </style>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>&#x062a;&#x0627;&#x0631;&#x06cc;&#x062e;</th>
                <th>&#x0627;&#x06cc;&#x0645;&#x06cc;&#x0644;</th>
                <th>&#x0645;&#x0648;&#x0636;&#x0648;&#x0639;</th>
                <th>&#x0645;&#x062a;&#x0646;</th>
                <th>&#x0648;&#x0636;&#x0639;&#x06cc;&#x062a;</th>
                <th>&#x0639;&#x0645;&#x0644;&#x06cc;&#x0627;&#x062a;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CreatedAt</td>
                    <td>@item.Email</td>
                    <td>@item.Subject</td>
                    <td>@item.Memo</td>
                    <td>@item.Status</td>
                    <td>
                        <div class="comm-actions">
                            @using (Html.BeginForm("MarkRead", "Communications", FormMethod.Post))
                            {
                                @Html.Hidden("id", item.Id)
                                <button class="btn btn-sm btn-primary" type="submit">&#x062e;&#x0648;&#x0627;&#x0646;&#x062f;&#x0647; &#x0634;&#x062f;</button>
                            }
                            @using (Html.BeginForm("DeleteMessage", "Communications", FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to delete this message?');" }))
                            {
                                @Html.Hidden("id", item.Id)
                                <button class="btn btn-sm btn-danger" type="submit">&#x062d;&#x0630;&#x0641;</button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
